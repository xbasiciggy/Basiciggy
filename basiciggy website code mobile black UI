            Trips
          </span>

        </a>

      </nav>


      <div
        id="bi-home-transition"
        class="bi-home-transition"
      ></div>

    `;



    document.body
      .appendChild(
        root
      );


    refreshIcons();



    /* =====================================================
       IMAGE ELEMENTS
       ===================================================== */

    const heroImage =
      root.querySelector(
        '#bi-home-hero-image'
      );


    const adventureImage =
      root.querySelector(
        '#bi-home-adventure-image'
      );


    const lifestyleImage =
      root.querySelector(
        '#bi-home-lifestyle-image'
      );


    const adventureLabel =
      root.querySelector(
        '#bi-adventures-current'
      );


    const lifestyleLabel =
      root.querySelector(
        '#bi-lifestyle-current'
      );



    /* =====================================================
       HERO
       ===================================================== */

    if (
      originalHero
    ) {

      setImage(
        heroImage,
        originalHero
      );

    }



    /* =====================================================
       TOP ADVENTURES GALLERY
       
       Current fallback = Banff.
       ===================================================== */

    getTopGalleryData(

      '/adventures',

      SECTION_FALLBACKS
        .adventures

    )
    .then(
      function(data) {

        if (
          data.photo
        ) {

          setImage(
            adventureImage,
            data.photo
          );


          /*
             Use latest Adventure photo as hero fallback
             if current homepage has no photo.
          */

          if (
            heroImage &&
            !heroImage.src
          ) {

            setImage(
              heroImage,
              data.photo
            );

          }

        }


        setCurrentGallery(
          adventureLabel,
          data.title
        );

      }
    );



    /* =====================================================
       TOP LIFESTYLE GALLERY
       ===================================================== */

    getTopGalleryData(

      '/lifestyle',

      SECTION_FALLBACKS
        .lifestyle

    )
    .then(
      function(data) {

        if (
          data.photo
        ) {

          setImage(
            lifestyleImage,
            data.photo
          );

        }


        setCurrentGallery(
          lifestyleLabel,
          data.title
        );

      }
    );



    /* =====================================================
       EXPLORE BUTTON
       ===================================================== */

    const sections =
      root.querySelector(
        '#bi-home-sections'
      );


    const explore =
      root.querySelector(
        '#bi-home-scroll-cue'
      );


    explore.addEventListener(
      'click',
      function() {

        root.scrollTo({

          top:
            sections.offsetTop,

          behavior:
            'smooth'

        });

      }
    );



    setupHomeAnimations(
      root
    );


    setupPageTransitions(
      root
    );

  }



  /* =========================================================
     HOME ANIMATIONS
     ========================================================= */

  function setupHomeAnimations(
    root
  ) {

    const hero =
      root.querySelector(
        '#bi-home-hero'
      );


    const media =
      root.querySelector(
        '#bi-home-hero-media'
      );


    const copy =
      root.querySelector(
        '#bi-home-hero-copy'
      );


    const nav =
      root.querySelector(
        '#bi-home-nav'
      );


    const cards =
      Array.from(
        root.querySelectorAll(
          '.bi-home-category'
        )
      );


    const reducedMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;



    /* =====================================================
       CARD REVEAL
       ===================================================== */

    if (
      'IntersectionObserver'
      in window
    ) {

      const observer =
        new IntersectionObserver(

          function(entries) {

            entries.forEach(
              function(entry) {

                if (
                  !entry.isIntersecting
                ) {

                  return;

                }


                entry.target
                  .classList
                  .add(
                    'bi-revealed'
                  );


                observer.unobserve(
                  entry.target
                );

              }
            );

          },

          {

            root:
              root,

            threshold:
              .16

          }

        );


      cards.forEach(
        function(card) {

          observer.observe(
            card
          );

        }
      );


    } else {

      cards.forEach(
        function(card) {

          card.classList.add(
            'bi-revealed'
          );

        }
      );

    }



    if (
      reducedMotion
    ) {

      return;

    }



    /* =====================================================
       PARALLAX
       ===================================================== */

    let ticking =
      false;


    root.addEventListener(

      'scroll',

      function() {

        if (
          ticking
        ) {

          return;

        }


        ticking =
          true;


        requestAnimationFrame(
          function() {

            const scrollY =
              root.scrollTop;


            const heroHeight =
              hero.offsetHeight;


            const progress =
              Math.min(
                Math.max(
                  scrollY /
                  heroHeight,
                  0
                ),
                1
              );



            media.style.transform =

              `translate3d(
                0,
                ${scrollY * .13}px,
                0
              )`;



            copy.style.opacity =

              String(
                Math.max(
                  0,
                  1 -
                  progress * 1.8
                )
              );



            copy.style.transform =

              `translate(
                -50%,
                calc(
                  -50%
                  - ${progress * 22}px
                )
              )`;



            /*
               Show floating navigation once user
               leaves the clean opening hero.
            */

            if (
              scrollY >
              heroHeight * .52
            ) {

              nav.classList.add(
                'bi-visible'
              );


            } else {

              nav.classList.remove(
                'bi-visible'
              );

            }


            ticking =
              false;

          }
        );

      },

      {
        passive:
          true
      }

    );

  }



  /* =========================================================
     PAGE TRANSITIONS
     ========================================================= */

  function setupPageTransitions(
    root
  ) {

    const overlay =
      root.querySelector(
        '#bi-home-transition'
      );


    const reducedMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;



    root
      .querySelectorAll(
        '[data-bi-transition]'
      )
      .forEach(
        function(link) {

          link.addEventListener(
            'click',
            function(event) {

              if (
                reducedMotion
              ) {

                return;

              }


              event.preventDefault();


              const destination =
                link.href;


              link.classList.add(
                'bi-opening'
              );


              overlay.classList.add(
                'bi-active'
              );


              window.setTimeout(
                function() {

                  window.location.href =
                    destination;

                },
                300
              );

            }
          );

        }
      );

  }



  /* =========================================================
     REMOVE HOME
     ========================================================= */

  function unmountHome() {

    document.documentElement
      .classList
      .remove(
        'bi-home-mode'
      );


    document.body
      .classList
      .remove(
        'bi-home-mode'
      );


    const root =
      document.getElementById(
        'bi-mobile-home'
      );


    if (
      root
    ) {

      root.remove();

    }

  }



  /* =========================================================
     ROUTER
     ========================================================= */

  function routeHome() {

    if (
      isMobile() &&
      isHome()
    ) {

      mountHome();

      return;

    }


    unmountHome();

  }



  /* =========================================================
     INIT
     ========================================================= */

  function initHome() {

    routeHome();

  }



  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(

      'DOMContentLoaded',

      initHome,

      {
        once:
          true
      }

    );


  } else {

    initHome();

  }



  /* =========================================================
     SAFARI BACK / FORWARD
     ========================================================= */

  window.addEventListener(
    'pageshow',
    routeHome
  );


  window.addEventListener(
    'popstate',
    routeHome
  );



  /* =========================================================
     ROTATION / RESIZE
     ========================================================= */

  let biHomeResizeTimer;


  window.addEventListener(

    'resize',

    function() {

      clearTimeout(
        biHomeResizeTimer
      );


      biHomeResizeTimer =
        setTimeout(
          routeHome,
          120
        );

    },

    {
      passive:
        true
    }

  );


})();

</script>
