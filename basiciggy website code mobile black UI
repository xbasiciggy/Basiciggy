  /* =========================================================
     LAZY LOAD PROJECT CARDS
     ========================================================= */

  function setupCardLoading(
    root,
    list
  ) {

    const cards =
      Array.from(
        root.querySelectorAll(
          '.bi-project-card'
        )
      );


    if (
      !('IntersectionObserver' in window)
    ) {

      cards.forEach(
        hydrateCard
      );


      return;

    }


    const observer =
      new IntersectionObserver(

        function(entries) {

          entries.forEach(
            function(entry) {

              if (
                !entry.isIntersecting
              ) {

                return;

              }


              hydrateCard(
                entry.target
              );


              observer.unobserve(
                entry.target
              );

            }
          );

        },

        {

          root:
            list,

          rootMargin:
            '500px 0px 500px 0px',

          threshold:
            0

        }

      );


    cards.forEach(
      function(card) {

        observer.observe(
          card
        );

      }
    );

  }



  /* =========================================================
     LOAD COVER / COUNT
     ========================================================= */

  async function hydrateCard(
    card
  ) {

    if (
      card.dataset.loaded ===
      'true' ||

      card.dataset.loading ===
      'true'
    ) {

      return;

    }


    card.dataset.loading =
      'true';


    const image =
      card.querySelector(
        '.bi-card-image'
      );


    const loader =
      card.querySelector(
        '.bi-card-loader'
      );


    const pill =
      card.querySelector(
        '.bi-card-pill'
      );


    try {

      const images =
        await getGalleryImages(
          card.dataset.href
        );


      if (
        pill &&
        images.length
      ) {

        pill.textContent =

          images.length +

          (
            images.length === 1
              ? ' moment'
              : ' moments'
          );

      }


      if (
        image &&
        images.length
      ) {

        image.onload =
          function() {

            image.classList.add(
              'bi-loaded'
            );


            if (loader) {

              loader.remove();

            }

          };


        image.onerror =
          function() {

            if (loader) {

              loader.remove();

            }

          };


        image.src =
          images[0];


      } else if (
        loader
      ) {

        loader.remove();

      }


      card.dataset.loaded =
        'true';


    } catch(error) {

      if (loader) {

        loader.remove();

      }

    }

  }



  /* =========================================================
     AUTO FIT LONG TITLES
     ========================================================= */

  function fitAllTitles() {

    document
      .querySelectorAll(
        '.bi-card-title'
      )
      .forEach(
        fitTitle
      );

  }



  function fitTitle(
    title
  ) {

    const holder =
      title.closest(
        '.bi-card-title-window'
      );


    if (!holder) {

      return;

    }


    const available =
      holder.clientWidth -
      24;


    if (
      available <= 0
    ) {

      return;

    }


    const MAX =
      96;


    const MIN =
      21;


    let low =
      MIN;


    let high =
      MAX;


    let best =
      MIN;



    for (
      let i = 0;
      i < 11;
      i++
    ) {

      const size =
        (low + high) / 2;


      title.style.fontSize =
        size + 'px';


      if (
        title.scrollWidth <=
        available
      ) {

        best =
          size;

        low =
          size;


      } else {

        high =
          size;

      }

    }


    title.style.fontSize =
      best.toFixed(1) +
      'px';



    if (
      best < 38
    ) {

      title.style.letterSpacing =
        '-.015em';


    } else if (
      best < 55
    ) {

      title.style.letterSpacing =
        '-.04em';


    } else {

      title.style.letterSpacing =
        '-.065em';

    }

  }



  /* =========================================================
     CUSTOM MOBILE GALLERY
     ========================================================= */

  async function mountGallery(
    section
  ) {

    if (
      !isMobile() ||
      !section ||
      !isSectionGallery(section)
    ) {

      return;

    }


    document.documentElement
      .classList
      .add(
        'bi-gallery-mode'
      );


    document.body
      .classList
      .add(
        'bi-gallery-mode'
      );


    let root =
      document.getElementById(
        'bi-mobile-gallery'
      );


    if (root) {

      return;

    }


    const path =
      getPath();


    const item =
      section.items.find(
        function(entry) {

          return (
            entry.href ===
            path
          );

        }
      );


    const title =

      item

      ? item.name

      : document.title
          .split('|')[0]
          .split('—')[0]
          .trim();



    root =
      document.createElement(
        'div'
      );


    root.id =
      'bi-mobile-gallery';



    root.innerHTML = `

      <div
        class="bi-gallery-top-fade"
      ></div>


      <a
        href="${section.path}"
        class="
          bi-gallery-back
          bi-glass
        "
        aria-label="Back"
      >

        <i
          data-lucide="arrow-left"
        ></i>

      </a>


      ${galleryLogoHTML()}


      <div
        class="bi-gallery-content"
      >

        <h1
          class="bi-gallery-title"
        >
          ${escapeHTML(title)}
        </h1>


        <div
          id="bi-gallery-loading"
          class="bi-gallery-loading"
        >

          <div
            class="bi-gallery-loading-ring"
          ></div>

        </div>


        <div
          id="bi-masonry"
          class="bi-masonry"
        ></div>

      </div>


      ${navHTML(
        section.id
      )}

    `;


    document.body
      .appendChild(
        root
      );


    refreshIcons();


    const masonry =
      root.querySelector(
        '#bi-masonry'
      );


    const loader =
      root.querySelector(
        '#bi-gallery-loading'
      );


    try {

      const images =
        await getGalleryImages(
          path
        );


      images.forEach(
        function(
          src,
          index
        ) {

          const galleryItem =
            document.createElement(
              'div'
            );


          galleryItem.className =
            'bi-masonry-item';


          const img =
            document.createElement(
              'img'
            );


          img.src =
            src;


          img.alt =
            title +
            ' photo ' +
            (index + 1);


          img.loading =
            index < 6
            ? 'eager'
            : 'lazy';


          galleryItem.appendChild(
            img
          );


          masonry.appendChild(
            galleryItem
          );

        }
      );


    } catch(error) {

      console.error(
        'Basiciggy gallery:',
        error
      );

    }


    if (loader) {

      loader.remove();

    }

  }



  /* =========================================================
     MAP
     ========================================================= */

  let map =
    null;


  let mapOverlay =
    null;



  function createMapOverlay() {

    if (
      mapOverlay
    ) {

      return mapOverlay;

    }


    mapOverlay =
      document.createElement(
        'div'
      );


    mapOverlay.id =
      'bi-map-overlay';



    mapOverlay.innerHTML = `

      <div
        id="bi-travel-map"
      ></div>


      <div
        class="bi-map-top-fade"
      ></div>


      <div
        class="bi-map-header"
      >

        <button
          id="bi-map-close"
          class="
            bi-map-close
            bi-glass
          "
          type="button"
          aria-label="Close map"
        >

          <i
            data-lucide="x"
          ></i>

        </button>


        <div
          class="bi-map-title"
        >
          Travel Map
        </div>

      </div>


      <div
        id="bi-map-preview"
        class="
          bi-map-preview
          bi-glass
        "
      >

        <div
          id="bi-map-preview-images"
          class="bi-map-preview-images"
        ></div>


        <div
          class="bi-map-preview-bottom"
        >

          <div
            class="bi-map-preview-copy"
          >

            <div
              class="bi-map-preview-label"
            >
              Gallery
            </div>


            <div
              id="bi-map-preview-title"
              class="bi-map-preview-title"
            ></div>


            <div
              id="bi-map-preview-count"
              class="bi-map-preview-count"
            ></div>

          </div>


          <a
            id="bi-map-view-gallery"
            class="bi-map-view-gallery"
            href="/adventures"
          >

            View Gallery

            <i
              data-lucide="arrow-up-right"
            ></i>

          </a>

        </div>

      </div>

    `;


    document.body
      .appendChild(
        mapOverlay
      );


    refreshIcons();



    mapOverlay
      .querySelector(
        '#bi-map-close'
      )
      .addEventListener(
        'click',
        closeMap
      );


    return mapOverlay;

  }



  /* =========================================================
     OPEN MAP
     ========================================================= */

  function openMap() {

    const overlay =
      createMapOverlay();


    overlay.classList.add(
      'bi-open'
    );



    if (!map) {

      map =
        L.map(
          'bi-travel-map',
          {

            zoomControl:
              false,

            attributionControl:
              true,

            worldCopyJump:
              true,

            preferCanvas:
              true

          }
        );



      /* ===================================================
         CARTO DARK RASTER BASEMAP
         API KEY INCLUDED
         =================================================== */

      const cartoURL =

        'https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}.png?key='

        +

        encodeURIComponent(
          CARTO_API_KEY
        );



      L.tileLayer(

        cartoURL,

        {

          maxZoom:
            20,

          attribution:
            '&copy; OpenStreetMap &copy; CARTO'

        }

      ).addTo(
        map
      );



      /* ===================================================
         CUSTOM PIN
         =================================================== */

      const pinIcon =
        L.divIcon({

          className:
            'bi-map-pin-wrapper',

          html:
            '<div class="bi-map-pin"></div>',

          iconSize:
            [24,24],

          iconAnchor:
            [12,12]

        });



      const bounds =
        [];



      /* ===================================================
         ADD ADVENTURE PINS
         =================================================== */

      adventures.forEach(
        function(trip) {

          const marker =
            L.marker(

              [
                trip.lat,
                trip.lng
              ],

              {
                icon:
                  pinIcon
              }

            )
            .addTo(
              map
            );


          marker.on(
            'click',
            function() {

              showMapPreview(
                trip
              );

            }
          );


          bounds.push(

            [
              trip.lat,
              trip.lng
            ]

          );

        }
      );



      map.fitBounds(

        bounds,

        {

          padding:
            [48,48]

        }

      );

    }



    window.setTimeout(
      function() {

        map.invalidateSize();

      },
      120
    );

  }



  /* =========================================================
     CLOSE MAP
     ========================================================= */

  function closeMap() {

    if (!mapOverlay) {

      return;

    }


    mapOverlay
      .classList
      .remove(
        'bi-open'
      );


    const preview =
      document.getElementById(
        'bi-map-preview'
      );


    if (preview) {

      preview
        .classList
        .remove(
          'bi-visible'
        );

    }

  }



  /* =========================================================
     MAP PIN → GALLERY PREVIEW
     ========================================================= */

  async function showMapPreview(
    trip
  ) {

    const preview =
      document.getElementById(
        'bi-map-preview'
      );


    const title =
      document.getElementById(
        'bi-map-preview-title'
      );


    const count =
      document.getElementById(
        'bi-map-preview-count'
      );


    const imageHolder =
      document.getElementById(
        'bi-map-preview-images'
      );


    const button =
      document.getElementById(
        'bi-map-view-gallery'
      );


    title.textContent =
      trip.name;


    count.textContent =
      'Loading preview…';


    button.href =
      trip.href;


    imageHolder.innerHTML =
      '';


    preview
      .classList
      .add(
        'bi-visible'
      );



    try {

      const images =
        await getGalleryImages(
          trip.href
        );


      count.textContent =

        images.length +

        (
          images.length === 1
            ? ' photo'
            : ' photos'
        );



      images
        .slice(
          0,
          3
        )
        .forEach(
          function(src) {

            const image =
              document.createElement(
                'img'
              );


            image.className =
              'bi-map-preview-image';


            image.src =
              src;


            image.alt =
              trip.name;


            imageHolder
              .appendChild(
                image
              );

          }
        );



      while (
        imageHolder.children.length <
        3
      ) {

        const filler =
          document.createElement(
            'div'
          );


        filler.className =
          'bi-map-preview-image';


        imageHolder
          .appendChild(
            filler
          );

      }


    } catch(error) {

      count.textContent =
        'Open gallery';

    }


    refreshIcons();

  }



  /* =========================================================
     CLEAR CUSTOM UI
     ========================================================= */

  function clearCustomUI() {

    document.documentElement
      .classList
      .remove(
        'bi-index-mode',
        'bi-gallery-mode'
      );


    document.body
      .classList
      .remove(
        'bi-index-mode',
        'bi-gallery-mode'
      );


    const indexRoot =
      document.getElementById(
        'bi-mobile-index'
      );


    const galleryRoot =
      document.getElementById(
        'bi-mobile-gallery'
      );


    if (indexRoot) {

      indexRoot.remove();

    }


    if (galleryRoot) {

      galleryRoot.remove();

    }

  }



  /* =========================================================
     ROUTER
     ========================================================= */

  function route() {

    if (!isMobile()) {

      clearCustomUI();

      closeMap();

      return;

    }


    const section =
      currentSection();


    if (!section) {

      clearCustomUI();

      closeMap();

      return;

    }



    /* =====================================================
       SECTION INDEX
       ===================================================== */

    if (
      isSectionIndex(
        section
      )
    ) {

      document.documentElement
        .classList
        .remove(
          'bi-gallery-mode'
        );


      document.body
        .classList
        .remove(
          'bi-gallery-mode'
        );


      const oldGallery =
        document.getElementById(
          'bi-mobile-gallery'
        );


      if (oldGallery) {

        oldGallery.remove();

      }


      mountIndex(
        section
      );


      return;

    }



    /* =====================================================
       SECTION GALLERY
       ===================================================== */

    if (
      isSectionGallery(
        section
      )
    ) {

      document.documentElement
        .classList
        .remove(
          'bi-index-mode'
        );


      document.body
        .classList
        .remove(
          'bi-index-mode'
        );


      const oldIndex =
        document.getElementById(
          'bi-mobile-index'
        );


      if (oldIndex) {

        oldIndex.remove();

      }


      closeMap();


      mountGallery(
        section
      );


      return;

    }



    clearCustomUI();

  }



  /* =========================================================
     INIT
     ========================================================= */

  function init() {

    route();

    refreshIcons();

  }



  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(

      'DOMContentLoaded',

      init,

      {
        once: true
      }

    );


  } else {

    init();

  }



  /* =========================================================
     SAFARI BACK/FORWARD
     ========================================================= */

  window.addEventListener(
    'pageshow',
    route
  );


  window.addEventListener(
    'popstate',
    route
  );



  /* =========================================================
     RESIZE / ROTATION
     ========================================================= */

  let resizeTimer;


  window.addEventListener(

    'resize',

    function() {

      clearTimeout(
        resizeTimer
      );


      resizeTimer =
        window.setTimeout(

          function() {

            route();


            fitAllTitles();



            if (
              map &&
              mapOverlay &&
              mapOverlay
                .classList
                .contains(
                  'bi-open'
                )
            ) {

              map.invalidateSize();

            }

          },

          120

        );

    },

    {
      passive: true
    }

  );


})();

</script>

















