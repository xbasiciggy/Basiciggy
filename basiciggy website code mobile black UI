  /* =========================================================
     URL / IMAGE HELPERS
     ========================================================= */

  function normalizeImageURL(
    src
  ) {

    if (!src) {
      return null;
    }


    try {

      const url =
        new URL(
          src,
          window.location.origin
        );


      if (
        url.hostname.includes(
          'squarespace'
        )
      ) {

        url.searchParams.set(
          'format',
          '1800w'
        );

      }


      return url.href;


    } catch(error) {

      return src;

    }

  }



  function getImageSource(
    image
  ) {

    return (

      image.getAttribute(
        'data-src'
      ) ||

      image.getAttribute(
        'data-image'
      ) ||

      image.getAttribute(
        'data-load'
      ) ||

      image.getAttribute(
        'src'
      ) ||

      null

    );

  }



  function shouldIgnoreImage(
    src
  ) {

    if (!src) {
      return true;
    }


    const lower =
      src.toLowerCase();


    return (

      lower.startsWith(
        'data:'
      ) ||

      lower.includes(
        'favicon'
      ) ||

      lower.includes(
        'avatar'
      ) ||

      lower.includes(
        'basiciggy+logo'
      ) ||

      lower.includes(
        'basiciggy%20logo'
      )

    );

  }



  /* =========================================================
     EXTRACT PHOTOS
     ========================================================= */

  function extractPhotosFromDocument(
    doc
  ) {

    const selectors = [

      '.gallery-grid-item img',

      '.gallery-masonry-item img',

      '.sqs-gallery img',

      '.sqs-block-image img',

      '.fluid-image-container img',

      'main img'

    ];


    const nodes =
      Array.from(
        doc.querySelectorAll(
          selectors.join(',')
        )
      );


    const images =
      [];


    const used =
      new Set();



    nodes.forEach(
      function(image) {

        let src =
          getImageSource(
            image
          );


        if (
          shouldIgnoreImage(
            src
          )
        ) {

          return;

        }


        src =
          normalizeImageURL(
            src
          );


        const key =
          src.split('?')[0];


        if (
          used.has(key)
        ) {

          return;

        }


        used.add(key);


        images.push(
          src
        );

      }
    );


    return images;

  }



  /* =========================================================
     FETCH A SQUARESPACE PAGE
     ========================================================= */

  async function fetchDocument(
    path
  ) {

    const response =
      await fetch(
        path,
        {
          credentials:
            'same-origin'
        }
      );


    if (!response.ok) {

      throw new Error(
        'Could not load ' +
        path
      );

    }


    const html =
      await response.text();


    return new DOMParser()
      .parseFromString(
        html,
        'text/html'
      );

  }



  /* =========================================================
     FIND TOP GALLERY LINK
     
     This scans the actual section page.
     
     Adventures:
     top gallery currently = Banff.
     
     Lifestyle:
     pulls whatever appears first on Lifestyle.
     ========================================================= */

  async function findTopGallery(
    sectionPath,
    fallback
  ) {

    try {

      const doc =
        await fetchDocument(
          sectionPath
        );


      /*
         Start with content-area links only.
         This avoids header/footer links as much as possible.
      */

      const selectors = [

        'main a[href]',

        '#page a[href]',

        '#sections a[href]',

        '.page-section a[href]'

      ];


      let links =
        Array.from(
          doc.querySelectorAll(
            selectors.join(',')
          )
        );


      /*
         Fallback if template structure differs.
      */

      if (
        !links.length
      ) {

        links =
          Array.from(
            doc.querySelectorAll(
              'a[href]'
            )
          );

      }


      const used =
        new Set();



      for (
        const link of links
      ) {

        const href =
          link.getAttribute(
            'href'
          );


        if (!href) {
          continue;
        }


        let pathname;


        try {

          pathname =
            new URL(
              href,
              window.location.origin
            )
            .pathname
            .replace(
              /\/+$/,
              ''
            );


        } catch(error) {

          continue;

        }


        if (
          !pathname.startsWith(
            sectionPath + '/'
          )
        ) {

          continue;

        }


        if (
          used.has(
            pathname
          )
        ) {

          continue;

        }


        used.add(
          pathname
        );


        return pathname;

      }


    } catch(error) {

      console.warn(
        'Could not determine top gallery:',
        sectionPath
      );

    }


    return fallback;

  }



  /* =========================================================
     FIND FIRST PHOTO FROM TOP GALLERY
     ========================================================= */

  async function getTopGalleryData(
    sectionPath,
    fallback
  ) {

    const galleryPath =
      await findTopGallery(
        sectionPath,
        fallback
      );


    if (!galleryPath) {

      return {
        path: null,
        title: '',
        photo: null
      };

    }


    try {

      const doc =
        await fetchDocument(
          galleryPath
        );


      const photos =
        extractPhotosFromDocument(
          doc
        );


      let title =
        '';


      const heading =
        doc.querySelector(
          'main h1, #page h1, h1'
        );


      if (
        heading &&
        heading.textContent
      ) {

        title =
          heading.textContent
            .trim();

      }


      if (!title) {

        const parts =
          galleryPath
            .split('/')
            .filter(Boolean);


        const slug =
          parts[
            parts.length - 1
          ] || '';


        title =
          slug

          .replace(
            /-[a-z0-9]{5}$/,
            ''
          )

          .replace(
            /-/g,
            ' '
          )

          .replace(
            /\b\w/g,
            function(letter) {

              return letter
                .toUpperCase();

            }
          );

      }


      return {

        path:
          galleryPath,

        title:
          title,

        photo:
          photos[0] || null

      };


    } catch(error) {

      return {

        path:
          galleryPath,

        title:
          '',

        photo:
          null

      };

    }

  }



