  /* =========================================================
     LOAD EXISTING SQUARESPACE GALLERY IMAGES
     ========================================================= */

  async function getGalleryImages(
    href
  ) {

    if (
      galleryCache[href]
    ) {

      return galleryCache[href];

    }


    const response =
      await fetch(
        href,
        {
          credentials:
            'same-origin'
        }
      );


    if (!response.ok) {

      throw new Error(
        'Unable to load gallery'
      );

    }


    const html =
      await response.text();


    const doc =
      new DOMParser()
        .parseFromString(
          html,
          'text/html'
        );


    const selectors = [

      '.gallery-grid-item img',

      '.gallery-masonry-item img',

      '.sqs-gallery img',

      '.sqs-block-image img',

      '.fluid-image-container img'

    ];


    const nodes =
      Array.from(
        doc.querySelectorAll(
          selectors.join(',')
        )
      );


    const images =
      [];


    const used =
      new Set();



    nodes.forEach(
      function(img) {

        let src =

          img.getAttribute(
            'data-src'
          ) ||

          img.getAttribute(
            'data-image'
          ) ||

          img.getAttribute(
            'data-load'
          ) ||

          img.getAttribute(
            'src'
          );


        if (!src) {

          return;

        }


        if (
          src.startsWith(
            'data:'
          )
        ) {

          return;

        }


        const lower =
          src.toLowerCase();


        if (
          lower.includes(
            'favicon'
          ) ||

          lower.includes(
            'avatar'
          )
        ) {

          return;

        }


        /*
          Don't accidentally use the Basiciggy logo
          as a gallery photo.
        */

        if (
          lower.includes(
            'basiciggy+logo'
          ) ||

          lower.includes(
            'basiciggy%20logo'
          )
        ) {

          return;

        }


        try {

          const url =
            new URL(
              src,
              window.location.origin
            );


          if (
            url.hostname.includes(
              'squarespace'
            )
          ) {

            url.searchParams.set(
              'format',
              '1500w'
            );

          }


          src =
            url.href;


        } catch(error) {}


        const uniqueKey =
          src.split('?')[0];


        if (
          used.has(
            uniqueKey
          )
        ) {

          return;

        }


        used.add(
          uniqueKey
        );


        images.push(
          src
        );

      }
    );


    galleryCache[href] =
      images;


    return images;

  }



